post_install() {
    cat <<EOF
==> WP Linux installed. As your normal user (not root), finish setup with:
==>   kwriteconfig6 --file kwinrc --group Plugins --key dev.wplinux.cursorbridgeEnabled --type bool true
==>   qdbus6 org.kde.KWin /KWin reconfigure
==> Then run 'wp_linux_editor', tick "Launch at login" (top right of the
==> Wallpapers tab) so render-server starts automatically from now on,
==> and start it once by hand for this session: render-server &
==> Finally, build a project and pick "WP Linux Wallpaper" in
==> System Settings > Appearance > Wallpaper.
==>
==> Optional example wallpapers (needs unzip):
==>   curl -fsSL https://github.com/AzimovIz/WP_Linux/releases/download/WallpaperExamples/WallpaperExamples.zip -o /tmp/wp-linux-examples.zip
==>   mkdir -p ~/.local/share/wp_linux/wallpapers
==>   unzip -oq /tmp/wp-linux-examples.zip -d ~/.local/share/wp_linux/wallpapers
EOF
}

post_upgrade() {
    cat <<EOF
==> WP Linux upgraded. As your normal user (not root), pick up the new
==> render-server binary for this session with:
==>   pkill -x render-server; render-server &
==> (Already-ticked "Launch at login" needs no changes -- it just points
==> at /usr/bin/render-server, which is now the new binary.)
EOF
}

pre_remove() {
    cat <<EOF
==> To fully remove WP Linux, also run as your normal user:
==>   pkill -x render-server
==>   rm -f ~/.config/autostart/dev.wplinux.render-server.desktop
==>   kwriteconfig6 --file kwinrc --group Plugins --key dev.wplinux.cursorbridgeEnabled --type bool false
EOF
}
