# Maintainer: AzimovIz
#
# Packages the prebuilt release archive rather than building from source
# -- bump pkgver to a release tag (YYYY.MM.DD), then run `updpkgsums` to
# fill in sha256sums before uploading to the AUR.
pkgname=wp-linux
pkgver=2026.08.06
pkgrel=1
pkgdesc="Animated, interactive wallpaper engine for KDE Plasma 6 on Wayland"
arch=('x86_64')
url="https://github.com/AzimovIz/WP_Linux"
license=('MIT')
depends=('plasma-workspace' 'kwin' 'hicolor-icon-theme')
optdepends=('power-profiles-daemon: pause rendering automatically in power-saver mode'
            'unzip: unpack the example wallpapers from the WallpaperExamples release')
install="${pkgname}.install"
source=("https://github.com/AzimovIz/WP_Linux/releases/download/${pkgver}/wp-linux-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/wp-linux"

    install -Dm755 bin/render-server "${pkgdir}/usr/bin/render-server"
    install -Dm755 bin/player "${pkgdir}/usr/bin/player"
    install -Dm755 bin/wp_linux_editor "${pkgdir}/usr/bin/wp_linux_editor"

    # KDE adapter (adapters/kde) -- Plasma/KWin auto-discover packages
    # under these system share dirs, no kpackagetool6 install step needed
    # at package-install time. This PKGBUILD only packages the KDE
    # adapter for now; a future GNOME adapter would need its own
    # packaging step here once adapters/gnome exists for real.
    install -d "${pkgdir}/usr/share/plasma/wallpapers/dev.wplinux.wallpaper"
    cp -r adapters/kde/plasma-plugin/package/. "${pkgdir}/usr/share/plasma/wallpapers/dev.wplinux.wallpaper/"

    install -d "${pkgdir}/usr/share/kwin/scripts/dev.wplinux.cursorbridge"
    cp -r adapters/kde/kwin-script/package/. "${pkgdir}/usr/share/kwin/scripts/dev.wplinux.cursorbridge/"

    # No systemd unit and no per-user autostart file installed here --
    # package() can't write into a specific user's $HOME. Autostart is
    # instead handled entirely by wp_linux_editor's own "Launch at login"
    # checkbox (crates/wp_linux_editor/src/autostart.rs), which resolves
    # render-server relative to its own executable path (/usr/bin here),
    # same as install.sh's ~/.local/bin layout.

    # Application menu entry, pointed at the /usr/bin wp_linux_editor
    # installed here instead of install.sh's ~/.local/bin/wp_linux_editor.
    install -d "${pkgdir}/usr/share/applications"
    sed 's|@EDITOR_BIN@|/usr/bin/wp_linux_editor|' dev.wplinux.editor.desktop \
        > "${pkgdir}/usr/share/applications/dev.wplinux.editor.desktop"
    chmod 644 "${pkgdir}/usr/share/applications/dev.wplinux.editor.desktop"

    # hicolor-icon-theme's pacman hook refreshes the icon cache on
    # install/upgrade, no manual gtk-update-icon-cache call needed here.
    install -Dm644 assets/wp_linux_editor_128.png \
        "${pkgdir}/usr/share/icons/hicolor/128x128/apps/dev.wplinux.editor.png"
    install -Dm644 assets/wp_linux_editor_256.png \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/dev.wplinux.editor.png"
    install -Dm644 assets/wp_linux_editor.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/dev.wplinux.editor.svg"
}
