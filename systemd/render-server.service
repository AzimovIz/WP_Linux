[Unit]
Description=WP Linux wallpaper render server
Documentation=https://github.com/AzimovIz/WP_Linux
# Needs a Wayland connection and a D-Bus session bus, both of which only
# exist inside an already-running graphical session -- not a system
# service, install under a systemd --user instance.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Matches where install.sh puts the binary (~/.local/bin). The AUR
# package installs system-wide instead and ships its own copy of this
# unit with ExecStart=/usr/bin/render-server.
ExecStart=%h/.local/bin/render-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
